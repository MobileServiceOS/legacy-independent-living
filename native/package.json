{
  "name": "legacy-living-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Native iOS shell (Capacitor) for the Legacy Independent Living portal",
  "scripts": {
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "ios:assets": "capacitor-assets generate --ios --iconBackgroundColor '#fbf8f1' --splashBackgroundColor '#fbf8f1'",
    "ios:patch": "node scripts/patch-ios.mjs",
    "ios:setup": "npm run ios:add && npm run ios:assets && npm run ios:patch && npm run ios:sync"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.9.0"
  }
}
