{
  "name": "legacy-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Legacy Independent Living — resident & owner portal (installable PWA)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:db && npm run test:integration",
    "test:unit": "node --test --test-reporter=spec tests/unit/*.test.ts",
    "test:db": "node --test --test-reporter=spec tests/db/*.test.ts",
    "test:integration": "node --import tsx --test --test-reporter=spec tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:check": "node scripts/check-schema-drift.mjs",
    "rent:run": "tsx scripts/run-rent-engine.ts",
    "icons": "python3 scripts/make-icons.py",
    "verify": "npm run typecheck && npm run lint && npm test",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "owner:create": "tsx scripts/create-owner.ts",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "review:account": "tsx scripts/create-review-account.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
