# ---- Required ---------------------------------------------------------------
# PostgreSQL 14+ connection string
DATABASE_URL="postgresql://legacy:legacy@localhost:5432/legacy_dev"
# Public URL of this app (used for invite links and payment return URLs)
APP_URL="http://localhost:3000"

# ---- Payments ---------------------------------------------------------------
# "mock"   = sandbox checkout inside the app (no money moves; blocked in production)
# "paypal" = PayPal Checkout (PayPal balance, bank, or debit/credit card as guest). ← production
# "stripe" = Stripe Checkout (alternative; cards + ACH)
# Card/bank data never touches this app.
PAYMENTS_PROVIDER="mock"
# PayPal: developer.paypal.com → Apps & Credentials → your app
# PAYPAL_ENV="sandbox"                # "live" for real money
# PAYPAL_CLIENT_ID="..."
# PAYPAL_CLIENT_SECRET="..."
# PAYPAL_WEBHOOK_ID="..."             # from the webhook you add for /api/webhooks/paypal
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Jobs -------------------------------------------------------------------
# Bearer token for POST /api/cron/rent (daily rent engine). Use a long random string.
CRON_SECRET="change-me-to-a-long-random-string"

# ---- Optional ---------------------------------------------------------------
# Where uploaded documents are stored (outside /public). Use a persistent volume in production.
STORAGE_DIR="./storage"
# Session lifetime in days
SESSION_DAYS="14"
# Simulate a different business date (demos/tests only): APP_TODAY="2026-10-01"
# Seed credentials (demo only)
# SEED_ADMIN_EMAIL="owner@legacy.demo"
# SEED_ADMIN_PASSWORD="LegacyDemo2026!"
