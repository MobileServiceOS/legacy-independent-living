# ---- Required ---------------------------------------------------------------
# PostgreSQL 14+ connection string
DATABASE_URL="postgresql://legacy:legacy@localhost:5432/legacy_dev"
# Public URL of this app (used for invite links and payment return URLs)
APP_URL="http://localhost:3000"

# ---- Payments ---------------------------------------------------------------
# "mock"   = sandbox checkout inside the app (no money moves; refused in production)
# unset    = in production: portal runs with online payments off until Stripe is set up
# "stripe" = Stripe Checkout: debit/credit card, Cash App Pay, bank account (ACH). ← production
# "paypal" = PayPal Checkout (alternative)
# Card/Cash App/bank data never touches this app.
PAYMENTS_PROVIDER="mock"
# Stripe: dashboard.stripe.com → Developers → API keys (secret key) and → Webhooks (signing secret)
# STRIPE_SECRET_KEY="sk_test_..."          # sk_live_... for real money
# STRIPE_WEBHOOK_SECRET="whsec_..."        # from the endpoint you add for /api/webhooks/stripe
# STRIPE_METHODS="DEBIT_CARD,CREDIT_CARD,CASH_APP,ACH"   # optional: what residents can choose, in order
# PayPal (alternative): developer.paypal.com → Apps & Credentials
# PAYPAL_ENV="sandbox"
# PAYPAL_CLIENT_ID="..."
# PAYPAL_CLIENT_SECRET="..."
# PAYPAL_WEBHOOK_ID="..."

# ---- Push notifications -----------------------------------------------------
# Web Push (browsers + installed PWA, incl. iPhone home-screen apps on iOS 16.4+).
# Generate once with `npm run push:keys` — changing keys invalidates existing subscriptions.
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:office@legacyindependentliving.net"
# Apple Push (native iOS app). developer.apple.com → Keys → "+" → Apple Push Notifications service.
# APNS_KEY_ID="ABC123DEFG"
# APNS_TEAM_ID="TEAM123456"
# APNS_BUNDLE_ID="net.legacyindependentliving.app"
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"   # contents of the .p8
# APNS_ENV="production"              # "sandbox" for Xcode debug builds
# Set to "off" to disable the instant send (the cron sweep still delivers). Tests use this.
# NOTIFY_SYNC_DELIVERY="off"

# ---- Jobs -------------------------------------------------------------------
# Bearer token for POST /api/cron/rent (daily rent engine) and /api/cron/notify (every 5 min).
# Use a long random string.
CRON_SECRET="change-me-to-a-long-random-string"

# ---- Optional ---------------------------------------------------------------
# Where uploaded documents are stored (outside /public). Use a persistent volume in production.
STORAGE_DIR="./storage"
# Proxies in front of the app that append to X-Forwarded-For (Railway = 1; Railway + Cloudflare proxy = 2).
# Used to find the real client IP for sign-in rate limits.
# TRUSTED_PROXY_HOPS="1"
# Session lifetime in days
SESSION_DAYS="14"
# Simulate a different business date (demos/tests only): APP_TODAY="2026-10-01"
# Seed credentials (demo only)
# SEED_ADMIN_EMAIL="owner@legacy.demo"
# SEED_ADMIN_PASSWORD="LegacyDemo2026!"
